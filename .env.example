# Server only. Never put email passwords or API keys in NEXT_PUBLIC_* variables.
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Gmail delivery: all visitor requests go to the official mailbox.
EMAIL_PROVIDER=gmail
GMAIL_USER=optimaworksgn@gmail.com
# Google application password, NOT the normal account password. Keep private.
GMAIL_APP_PASSWORD=
CONTACT_TO=optimaworksgn@gmail.com

# Optional alternative: set EMAIL_PROVIDER=resend and configure these instead.
RESEND_API_KEY=
CONTACT_FROM=

# Absolute canonical production/staging URL. For local preview, leave empty.
SITE_URL=
# Leave false until content, contact details and legal documents are approved.
SITE_INDEXABLE=false
# Enable ONLY behind a trusted proxy overwriting x-forwarded-for.
TRUST_PROXY=false
