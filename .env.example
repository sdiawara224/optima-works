# Ne jamais renseigner de secret dans ce fichier versionné. Utiliser .env.local ou les variables privées de l’hébergeur.
# Server only. Never put email passwords or API keys in NEXT_PUBLIC_* variables.
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Gmail SMTP (private server configuration). Google application password only.
EMAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=optimaworksgn@gmail.com
SMTP_PASSWORD=
CONTACT_EMAIL=optimaworksgn@gmail.com

# Enable acknowledgements only after configuring both Turnstile keys below.
CONTACT_AUTOREPLY_ENABLED=false
# Only the SITE KEY is public. The secret must never use NEXT_PUBLIC_.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Legacy aliases remain supported; prefer SMTP_* and CONTACT_EMAIL above.
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_TO=

# Optional alternative: set EMAIL_PROVIDER=resend and configure these instead.
RESEND_API_KEY=
CONTACT_FROM=

# Absolute canonical production/staging URL. For local preview, leave empty.
SITE_URL=
# Leave false until content, contact details and legal documents are approved.
SITE_INDEXABLE=false
# Vercel automatically uses its overwritten proxy header. Else enable ONLY behind a trusted proxy.
TRUST_PROXY=false
